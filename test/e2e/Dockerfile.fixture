FROM golang:1.24-alpine AS build
WORKDIR /src
COPY test/e2e/fixture.go ./fixture.go
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/mogate-fixture ./fixture.go

FROM alpine:3.22
COPY --from=build /out/mogate-fixture /usr/local/bin/mogate-fixture
ENTRYPOINT ["/usr/local/bin/mogate-fixture"]
