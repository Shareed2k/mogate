FROM golang:1.24-alpine AS build
RUN apk add --no-cache build-base
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY injector ./injector
RUN go build -trimpath -o /out/mogate ./cmd/mogate
RUN sed -n '/^\/\*$/,/^\*\/$/p' injector/main.go | sed '1d;$d;/^#cgo /d' | \
    cc -x c -Iinjector -O2 -fPIC -shared -ldl -pthread -o /out/libmogate.so -

FROM alpine:3.22
RUN apk add --no-cache bash bind-tools busybox-extras ca-certificates curl wget
COPY --from=build /out/mogate /usr/local/bin/mogate
COPY --from=build /out/libmogate.so /usr/local/bin/libmogate.so
ENTRYPOINT ["/usr/local/bin/mogate"]
